# ── Database (Neon PostgreSQL) ──────────────────────────────────────────────
# Pooled endpoint (host contains "-pooler") — used at runtime via @prisma/adapter-neon.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
# Direct endpoint (no "-pooler") — used by `prisma db push` / migrations only.
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# ── Admin auth ──────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="<strong-password>"
# 32+ random chars. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# ── Supabase Storage (optional: product image uploads, public "product-images" bucket) ──
NEXT_PUBLIC_SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# ── Contact defaults (overridden by /admin/settings once DB is connected) ───
NEXT_PUBLIC_WHATSAPP_NUMBER="218915229703"
NEXT_PUBLIC_SITE_URL="https://gpower.store"

# For `npm run preview` (local workerd), copy this file to .dev.vars as well.
